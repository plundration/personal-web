---
import BaseLayout from '@/layouts/BaseLayout.astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/gallery/*.{jpeg,jpg,png,gif,webp,png}',
);

const photos = await Promise.all(
    Object.entries(imageModules).map(async ([filepath, resolve]) => {
        const mod = await resolve();
        const filename = filepath.split('/').pop() ?? 'unnamed.raw';

        return {
            asset: mod.default,
            filename,
            dimensions: `${mod.default.width}x${mod.default.height}`,
            format: mod.default.format.toUpperCase(),
        };
    }),
);
---

<BaseLayout>
    <main class="mx-auto w-full max-w-screen-2xl grow space-y-6 px-2">
        <div
            class="columns-1 gap-4 space-y-4 sm:columns-2 md:columns-3 lg:columns-4"
        >
            {
                photos.map((photo, index) => (
                    <figure class="border-border bg-panel group hover:border-accent relative break-inside-avoid overflow-hidden border p-2 transition-all duration-300">
                        <div class="bg-canvas relative overflow-hidden">
                            <img
                                src={photo.asset.src}
                                alt={photo.filename}
                                loading="lazy"
                                class="h-auto w-full object-cover transition group-hover:scale-105"
                            />

                            <span class="bg-ink text-canvas absolute top-2 left-2 px-1 font-mono text-[10px] opacity-80">
                                [{index < 10 ? `0${index}` : index}]
                            </span>
                        </div>

                        <figcaption class="mt-2 flex flex-col gap-1 font-mono text-[11px]">
                            <div class="text-ink flex items-center justify-between font-bold">
                                <span class="truncate">{photo.filename}</span>
                                <span class="flex gap-1 text-[9px]">
                                    <span class="text-zinc-500">
                                        {photo.dimensions}
                                    </span>
                                    <span class="text-accent">
                                        [{photo.format}]
                                    </span>
                                </span>
                            </div>
                        </figcaption>
                    </figure>
                ))
            }
        </div>
    </main>
</BaseLayout>
